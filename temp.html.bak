<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Correction Portfolio Skills</title>
    <style>
        body {
            background-color: #0f0f1a; /* Fond très sombre pour faire ressortir le néon */
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            color: white;
            font-family: sans-serif;
        }

        .container {
            display: flex;
            gap: 50px;
        }

        /* Style commun pour les badges */
        .skill-badge {
            position: relative;
            width: 150px;
            height: 150px;
            display: flex;
            justify-content: center;
            align-items: center;
            /* Le drop-shadow permet de voir l'éclat autour du clip-path */
            filter: drop-shadow(0 0 10px var(--glow-color));
            transition: transform 0.3s;
        }

        .skill-badge:hover {
            transform: scale(1.1);
        }

        /* La forme découpée */
        .shape {
            position: absolute;
            width: 100%;
            height: 100%;
            background: var(--bg-color);
            border: 2px solid var(--glow-color); /* Note: border ne suit pas clip-path nativement */
            clip-path: var(--path);
            z-index: 1;
        }

        /* Contenu textuel */
        .label {
            position: relative;
            z-index: 2;
            font-weight: bold;
            text-shadow: 0 0 5px black;
        }

        /* --- VARIABLES PAR COMPÉTENCE --- */

        .css {
            --glow-color: #00d2ff;
            --bg-color: rgba(0, 210, 255, 0.3);
            /* HEXAGONE */
            --path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);
        }

        .php {
            --glow-color: #ff00ff;
            --bg-color: rgba(255, 0, 255, 0.3);
            /* BOUCLIER */
            --path: polygon(0% 0%, 100% 0%, 100% 70%, 50% 100%, 0% 70%);
        }

        .python {
            --glow-color: #ffe600;
            --bg-color: rgba(255, 230, 0, 0.3);
            /* CRISTAL ASYMÉTRIQUE */
            --path: polygon(20% 0%, 80% 10%, 100% 40%, 70% 100%, 0% 80%, 10% 30%);
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="skill-badge css">
            <div class="shape"></div>
            <span class="label">CSS</span>
        </div>

        <div class="skill-badge php">
            <div class="shape"></div>
            <span class="label">PHP</span>
        </div>

        <div class="skill-badge python">
            <div class="shape"></div>
            <span class="label">PYTHON</span>
        </div>
    </div>

</body>
</html>